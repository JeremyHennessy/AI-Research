  "proposition": "Physically produced state may evolve useful decay/retention and reliability-dependent selective transmission within fixed finite-resource ecological laws, beyond a pre-installed regulator or engineered memory array.",
  "properties": [
    "measurable source-derived environmental history",
    "held-out ecological viability advantage",
    "explicit storage/expression/reset resource costs",
    "cue reliability reversal generalization",
    "endogenous retention mechanism and causal necessity",
    "functional daughter/granddaughter inheritance"
  ],
  "critical_comparators": [
    "matched no-memory history null",
    "passive molecular carryover",
    "permanent expression and storage with cost",
    "fixed low-pass/integral-feedback control",
    "stochastic fast/slow phenotype switching",
    "programmed memory-decay rule as shortcut benchmark",
    "carrier knockout+rescue",
    "unexpected cue–resource relationship reversal",
    "unanticipated permanent resource shift",
    "daughter all-copy/no-copy/passive partition"
  ],
  "reject_on": [
    "no functional advantage after causal resource/physiology matching",
    "higher mutual information only, no survival benefit",
    "same result from preinstalled fixed circuitry at matched cost",
    "observer supplied a dedicated memory API or future-state reward",
    "benefit lost under ecological reversal",
    "offspring selected survivors only or no independent lineage structure"
  ],
